<Window x:Class="RoutineRest.App.RestWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Routine Rest · 休息时间" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="#F5F3EA">
 <Viewbox Stretch="Uniform">
  <Grid Width="1440" Height="900" Margin="0" Background="#F5F3EA">
   <Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="200"/><RowDefinition Height="70"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="64,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#284D3E" CornerRadius="13" Width="42" Height="42" Margin="0,0,14,0"><Path Data="M 12,27 C 9,13 20,9 31,10 C 32,23 24,32 12,27 M 12,27 L 25,16" Stroke="#E4EDD7" StrokeThickness="2" Stretch="None"/></Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="routine rest" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="把十分钟，还给生活。" FontSize="12" Foreground="#6B776B" Margin="0,4,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Ellipse Fill="#62866A" Width="8" Height="8" Margin="0,0,9,0"/><TextBlock Text="{Binding ModeText}" Foreground="#61715E" FontSize="14"/><TextBlock Text="{Binding DateLabel}" Margin="28,0,0,0" Foreground="#61715E" FontSize="14"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="64,4,64,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#E6EBDC" CornerRadius="28" Margin="0,0,24,0">
     <Grid>
      <Ellipse x:Name="BreathingCircle" Width="380" Height="380" Stroke="#CDD9C0" StrokeThickness="1.5" Opacity="0.75" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
      <Ellipse Width="316" Height="316" Stroke="#D3DEC8" StrokeThickness="1.5"/>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
       <TextBlock Text="现在，安心休息。" FontSize="28" HorizontalAlignment="Center"/>
       <TextBlock Text="{Binding Countdown}" FontFamily="Segoe UI Light" FontSize="122" FontWeight="Light" HorizontalAlignment="Center" Margin="0,4,0,0"/>
       <TextBlock Text="剩余休息时间" FontSize="14" Foreground="#62705C" HorizontalAlignment="Center"/>
       <Border Background="#D6E1CC" CornerRadius="20" Padding="18,9" Margin="0,30,0,0" HorizontalAlignment="Center"><TextBlock Text="电脑继续忙，你可以慢下来。" FontSize="14"/></Border>
      </StackPanel>
      <ProgressBar Value="{Binding RestProgress, Mode=OneWay}" Maximum="100" Height="3" Margin="44,0,44,26" VerticalAlignment="Bottom" Foreground="#668269" Background="#CDD9C4" BorderThickness="0"/>
     </Grid>
    </Border>
    <Grid Grid.Column="1">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
     <Border Background="#FFFEFA" CornerRadius="28" Padding="26">
      <StackPanel>
       <TextBlock Text="{Binding ActivityEyebrow}" FontSize="12" Foreground="#827354"/>
       <TextBlock Text="{Binding ActivityTitle}" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,10"/>
       <TextBlock Text="{Binding ActivityBody}" FontSize="16" Foreground="#617063" TextWrapping="Wrap" LineHeight="25"/>
       <Grid Height="52" Margin="0,10,0,0">
        <Path Stretch="Uniform" Height="52" Stroke="#8B9C7D" StrokeThickness="2.2" StrokeLineJoin="Round" HorizontalAlignment="Right" Margin="0,0,16,0" Data="M 10,78 C 4,68 9,49 22,44 L 24,14 L 43,28 C 53,24 66,24 75,28 L 94,14 L 96,46 C 106,58 99,77 87,81 C 69,88 33,89 10,78 M 42,49 L 47,49 M 73,49 L 78,49 M 59,57 L 63,57 L 61,61 Z M 44,67 Q 61,79 79,67 M 9,56 L 28,59 M 9,66 L 28,65 M 91,59 L 110,56 M 91,65 L 110,68"/>
        <TextBlock Text="喝水 · 活动 · 家务 · 猫猫" Foreground="#78816E" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
       </Grid>
      </StackPanel>
     </Border>
     <Border Grid.Row="1" Background="#E4ECED" CornerRadius="22" Margin="0,14,0,0" Padding="26,15">
      <StackPanel>
       <Grid><TextBlock Text="今天的饮水目标" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding WaterStatus}" HorizontalAlignment="Right" Foreground="#456970" FontSize="13" VerticalAlignment="Center"/></Grid>
       <ItemsControl ItemsSource="{Binding WaterCups}" Margin="0,10,0,7" AutomationProperties.Name="{Binding WaterAccessibleLabel}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding WaterCupColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Grid Width="40" Height="53" Margin="0,0,9,4" HorizontalAlignment="Left">
          <Border Width="32" Height="46" Background="#F7FAF9" CornerRadius="3,3,7,7" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,2,0,0"/>
          <Grid Width="28" Height="42" Margin="4,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
           <Border Background="#74A8B4" Height="{Binding FillHeight}" VerticalAlignment="Bottom" CornerRadius="0,0,4,4"/>
           <Border BorderBrush="#447B89" BorderThickness="0,1.5,0,0" Height="{Binding FillHeight}" VerticalAlignment="Bottom"/>
          </Grid>
          <Path Data="M 2,2 L 2,40 Q 2,48 10,48 L 26,48 Q 34,48 34,40 L 34,2" Stroke="#54818B" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
          <Path Data="M 6,1 L 30,1" Stroke="#54818B" StrokeThickness="1.5"/>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock Text="每杯 300 ml · 实色是已喝，空杯留给稍后" Foreground="#506C72" FontSize="12"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
   <Grid Grid.Row="2" Margin="64,0,64,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#FFFEFA" CornerRadius="22" Margin="0,0,24,0" Padding="28,23">
     <StackPanel><TextBlock Text="今天的节奏" FontSize="14" Foreground="#697366"/>
      <UniformGrid Columns="3" Margin="0,22,0,0">
       <StackPanel><TextBlock Text="{Binding WorkLabel}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="已工作" Foreground="#6D786B" Margin="0,9,0,0"/></StackPanel>
       <StackPanel><TextBlock Text="{Binding RestLabel}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding BreakLabel}" Foreground="#6D786B" Margin="0,9,0,0"/></StackPanel>
       <StackPanel><TextBlock Text="{Binding WaterLabel}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="水杯进度见右上方" Foreground="#6D786B" Margin="0,9,0,0"/></StackPanel>
      </UniformGrid>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="#294A3D" CornerRadius="22" Padding="28,23">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="56" Height="56" VerticalAlignment="Top" Margin="0,20,0,0"><Ellipse Fill="#4E6D57"/><Ellipse Width="26" Height="26" Stroke="#A2B99B" StrokeThickness="1"/><Ellipse Width="7" Height="7" Fill="#DFE7D4"/></Grid>
      <StackPanel Grid.Column="1"><TextBlock Text="休息电台" Foreground="#B9CBB3" FontSize="12"/><TextBlock Text="{Binding MusicTitle}" Foreground="#F7F4E9" FontSize="20" Margin="0,12,0,7" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MusicStatus}" Foreground="#C5D1BD" FontSize="12" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding MusicProgress, Mode=OneWay}" Maximum="100" Height="3" Foreground="#C5D3A9" Background="#4C6855" BorderThickness="0" Margin="0,16,0,0"/></StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="3" Margin="64,0">
    <TextBlock Text="键鼠已暂停响应 · 到点自动恢复 · 后台任务继续运行" Foreground="#778071" FontSize="12" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding EmergencyText}" Foreground="#778071" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </Grid>
  </Grid>
 </Viewbox>
</Window>